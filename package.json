{
  "name": "yt-transcript-studio",
  "private": true,
  "version": "0.1.0",
  "description": "TubeScribe — YouTube transcripts and AI summaries",
  "author": "Ronak Singh Raina",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/ensure-dev-index.mjs && vite",
    "build": "node scripts/ensure-dev-index.mjs && vite build",
    "build:pages": "node scripts/ensure-dev-index.mjs && vite build --base /YT-Transcript/ && node scripts/copy-404.mjs && node scripts/publish-static.mjs",
    "gen:icons": "node scripts/generate-icons.mjs",
    "build:desktop": "node scripts/prepare-desktop-env.mjs && node scripts/write-electron-api-origin.mjs && node scripts/ensure-dev-index.mjs && vite build --mode desktop",
    "preview": "vite preview",
    "preview:pages": "vite preview --base /YT-Transcript/",
    "electron:dev": "node scripts/electron-dev.mjs",
    "dist:win": "npm run gen:icons && npm run build:desktop && electron-builder --win nsis",
    "build:extension": "node scripts/prepare-extension-env.mjs && vite build --mode extension && node scripts/copy-extension-assets.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "tailwindcss": "^4.3.0"
  },
  "build": {
    "appId": "com.tubescribe.app",
    "productName": "TubeScribe",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TubeScribe"
    }
  }
}
