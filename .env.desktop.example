# Copy to .env.desktop and fill in before: npm run build:desktop
# Used only for the Windows desktop installer build (not committed with secrets).

VITE_IS_DESKTOP=true
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Required — your Vercel deployment API (same as GitHub Pages):
VITE_TRANSCRIPT_API=https://your-app.vercel.app/api/transcript
