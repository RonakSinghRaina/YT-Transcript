VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: defaults to /api/transcript (Apify). Only set if you still use a Supabase edge function.
# VITE_TRANSCRIPT_API=/api/transcript
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
APIFY_TOKEN=your-apify-token
APIFY_ACTOR_ID=prodiger/youtube-transcript-scraper---transcriber
# auto = captions when available, else Whisper (needs OPENAI_API_KEY). captions = captions only.
APIFY_TRANSCRIPT_METHOD=auto
APIFY_PREFERRED_LANGUAGE=en
# Apify skips videos longer than this (actor default is 18). Use up to 300 for long podcasts.
APIFY_MAX_DURATION_MINUTES=120
# Recommended for accurate video summaries (third-person, topic-faithful).
# Without either key, summaries use transcript extractive mode (less detailed).
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-4o-mini
# Alternative: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_SUMMARY_MODEL=gemini-2.0-flash
